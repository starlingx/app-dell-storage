+---
+
 apiVersion: v1
 kind: Service
 metadata:
@@ -65,6 +75,7 @@ spec:
         app.kubernetes.io/name: otel-collector
         app.kubernetes.io/instance: {{ .Release.Name }}
     spec:
+      serviceAccount: otel-collector
       volumes:
       - name: tls-secret
         secret:
