From 152b805073b39b2383c6245255986b631d96af08 Mon Sep 17 00:00:00 2001
From: Guilherme Costa <guilherme.costa@windriver.com>
Date: Tue, 26 Mar 2024 15:46:25 -0300
Subject: [PATCH] csm-replication: add default values for templates

This patch consists of adding the default values in the values.yaml of
the helm chart.
It's necessary because templates need default values to be able
to build the package.

Signed-off-by: Guilherme Costa <guilherme.costa@windriver.com>
---
 charts/csm-replication/values.yaml | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/charts/csm-replication/values.yaml b/charts/csm-replication/values.yaml
index 3a13510..9077a06 100644
--- a/charts/csm-replication/values.yaml
+++ b/charts/csm-replication/values.yaml
@@ -35,3 +35,9 @@ retryIntervalMax: 5m
 #  - ip: "10.10.10.11"
 #    hostnames:
 #      - "foo.baz"
+
+config:
+  clusterId: ""
+
+replicationGroup:
+  create: false
-- 
2.25.1
