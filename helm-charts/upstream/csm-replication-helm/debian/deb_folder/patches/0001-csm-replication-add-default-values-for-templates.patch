From a3c56a97ecca5e201fcd1c36b9a8d43ce2e71146 Mon Sep 17 00:00:00 2001
From: Gustavo Ornaghi Antunes <gustavo.ornaghiantunes@windriver.com>
Date: Fri, 13 Dec 2024 11:56:43 +0000
Subject: [PATCH] csm-replication: add default values for templates

This patch consists of adding the default values in the values.yaml of
the helm chart.
It's necessary because templates need default values to be able
to build the package.

Signed-off-by: Gustavo Ornaghi Antunes <gustavo.ornaghiantunes@windriver.com>
---
 charts/csm-replication/values.yaml | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/charts/csm-replication/values.yaml b/charts/csm-replication/values.yaml
index 4329d04..9172cfd 100644
--- a/charts/csm-replication/values.yaml
+++ b/charts/csm-replication/values.yaml
@@ -35,3 +35,12 @@ retryIntervalMax: 5m
 #  - ip: "10.10.10.11"
 #    hostnames:
 #      - "foo.baz"
+
+config:
+  clusterId: ""
+
+replicationGroup:
+  create: false
+
+kubectl:
+  image: docker.io/bitnami/kubectl:1.29
-- 
2.34.1

