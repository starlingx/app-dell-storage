From 8d36a41368cb36da78cffd65e507bb80a7968f5c Mon Sep 17 00:00:00 2001
From: Guilherme Costa <guilherme.costa@windriver.com>
Date: Tue, 26 Mar 2024 15:48:51 -0300
Subject: [PATCH] csm-replication: support setting config values

This patch consists of changing the config.yaml that is hard-coded
on the controller template for support the dynamic values.
Before, we needed change the configmap manually before deploy.

Signed-off-by: Guilherme Costa <guilherme.costa@windriver.com>
---
 charts/csm-replication/templates/controller.yaml | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/charts/csm-replication/templates/controller.yaml b/charts/csm-replication/templates/controller.yaml
index 8384676..cb795ce 100644
--- a/charts/csm-replication/templates/controller.yaml
+++ b/charts/csm-replication/templates/controller.yaml
@@ -224,8 +224,12 @@ data:
 {{ else -}}
 data:
   config.yaml: |
-    clusterId: ""
+    clusterId: {{ .Values.config.clusterId }}
+    {{- if .Values.config.targets }}
+    targets: {{- .Values.config.targets | toYaml | nindent 4 }}
+    {{- else }}
     targets: []
+    {{- end }}
     CSI_LOG_LEVEL: {{ .Values.logLevel }}
 {{ end }}
 ---
-- 
2.25.1
