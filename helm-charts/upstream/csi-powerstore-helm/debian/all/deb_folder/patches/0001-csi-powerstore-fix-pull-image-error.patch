From f83d2e435bc04ddfa67eb4006dbdba4595c8149b Mon Sep 17 00:00:00 2001
From: Alyson Deives Pereira <alyson.deivespereira@windriver.com>
Date: Tue, 28 Apr 2026 09:27:12 -0300
Subject: [PATCH] csi-powerstore: fix pull image error

This patch consists of adding imagePullSecrets with name
default-registry-key only in ServiceAccounts.
It's necessary because without it the system can't use the
images from the registry local.

Signed-off-by: Gabriel Przybysz Gonçalves Júnior <gabriel.przybsyzgoncalvesjunior@windriver.com>
Signed-off-by: Alyson Deives Pereira <alyson.deivespereira@windriver.com>
---
 charts/csi-powerstore/templates/controller.yaml | 3 ++-
 charts/csi-powerstore/templates/node.yaml       | 3 ++-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/charts/csi-powerstore/templates/controller.yaml b/charts/csi-powerstore/templates/controller.yaml
index 5eb239a..a1989c0 100644
--- a/charts/csi-powerstore/templates/controller.yaml
+++ b/charts/csi-powerstore/templates/controller.yaml
@@ -21,7 +21,8 @@ kind: ServiceAccount
 metadata:
   name: {{ .Release.Name }}-controller
   namespace: {{ .Release.Namespace }}
-
+imagePullSecrets:
+  - name: default-registry-key
 ---
 # ClusterRole for Cluster-specific Permissions
 kind: ClusterRole
diff --git a/charts/csi-powerstore/templates/node.yaml b/charts/csi-powerstore/templates/node.yaml
index 6879f24..9d01a87 100644
--- a/charts/csi-powerstore/templates/node.yaml
+++ b/charts/csi-powerstore/templates/node.yaml
@@ -21,7 +21,8 @@ kind: ServiceAccount
 metadata:
   name: {{ .Release.Name }}-node
   namespace: {{ .Release.Namespace }}
-
+imagePullSecrets:
+  - name: default-registry-key
 ---
 # ClusterRole for Cluster-specific Permissions
 kind: ClusterRole
--
2.34.1