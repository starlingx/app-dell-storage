From 9d7f71fcb6ae21287a1392058949d8d36c53f91b Mon Sep 17 00:00:00 2001
From: Alyson Deives Pereira <alyson.deivespereira@windriver.com>
Date: Wed, 25 Mar 2026 13:53:06 -0300
Subject: [PATCH] csi-powerstore: add default values for templates

This patch consists of adding the default values in the values.yaml of
the helm chart.
It's necessary because the images in templates were in unexpected format
for the system and because templates need default values to be able
to build the package.

Signed-off-by: Gabriel Przybysz Gonçalves Júnior <gabriel.przybsyzgoncalvesjunior@windriver.com>
Signed-off-by: Alyson Deives Pereira <alyson.deivespereira@windriver.com>
---
 charts/csi-powerstore/values.yaml | 52 +++++++++++++------------------
 1 file changed, 21 insertions(+), 31 deletions(-)

diff --git a/charts/csi-powerstore/values.yaml b/charts/csi-powerstore/values.yaml
index 9fb3d50..e5a4384 100644
--- a/charts/csi-powerstore/values.yaml
+++ b/charts/csi-powerstore/values.yaml
@@ -25,37 +25,8 @@ driverName: "csi-powerstore.dellemc.com"
 # Not recommend to change
 version: v2.16.0

-# "images" defines every container images used for the driver and its sidecars.
-#  To use your own images, or a private registry, change the values here.
-images:
-  # "driver" defines the container image, used for the driver container.
-  driver:
-    image: quay.io/dell/container-storage-modules/csi-powerstore:v2.16.0
-  # CSI sidecars
-  attacher:
-    image: registry.k8s.io/sig-storage/csi-attacher:v4.10.0
-  provisioner:
-    image: registry.k8s.io/sig-storage/csi-provisioner:v6.1.0
-  snapshotter:
-    image: registry.k8s.io/sig-storage/csi-snapshotter:v8.4.0
-  resizer:
-    image: registry.k8s.io/sig-storage/csi-resizer:v2.0.0
-  registrar:
-    image: registry.k8s.io/sig-storage/csi-node-driver-registrar:v2.15.0
-  healthmonitor:
-    image: registry.k8s.io/sig-storage/csi-external-health-monitor-controller:v0.16.0
-
-  # CSM sidecars
-  replication:
-    image: quay.io/dell/container-storage-modules/dell-csi-replicator:v1.14.0
-  vgsnapshotter:
-    image: quay.io/dell/container-storage-modules/csi-volumegroup-snapshotter:v1.8.1
-  podmon:
-    image: quay.io/dell/container-storage-modules/podmon:v1.15.0
-  metadataretriever:
-    image: quay.io/dell/container-storage-modules/csi-metadata-retriever:v1.13.0
-  authorization:
-    image: quay.io/dell/container-storage-modules/csm-authorization-sidecar:v2.4.0
+driver:
+  image: quay.io/dell/container-storage-modules/csi-powerstore:v2.16.0

 # Represents number of certificate secrets, which user is going to create for ssl authentication. (powerstore-cert-0..powerstore-cert-n)
 # If user does not use certificate, set to 0
@@ -144,6 +115,12 @@ controller:
   # Examples: "k8s", "app1"
   volumeNamePrefix: csivol

+  attacher:
+    image: registry.k8s.io/sig-storage/csi-attacher:v4.10.0
+
+  metadataretriever:
+    image: quay.io/dell/container-storage-modules/csi-metadata-retriever:v1.13.0
+
   # vgsnapshot: allows to configure volume-group-snapshot
   # volume-group-snapshot CRDs must be installed before installing driver
   vgsnapshot:
@@ -153,6 +130,8 @@ controller:
     #   false: disable volume-group-snapshot feature(do not install vg-snapshotter sidecar)
     # Default value: false
     enabled: false
+    vgsnapshotter:
+      image: quay.io/dell/container-storage-modules/csi-volumegroup-snapshotter:v1.8.1

   # snapshot: allows to enable/disable snapshot feature
   # snapshot CRDs needs to be installed before enabling this feature
@@ -163,6 +142,8 @@ controller:
     #   false: disable volume snapshot feature(do not install snapshotter sidecar)
     # Default value: None
     enabled: true
+    snapshotter:
+      image: registry.k8s.io/sig-storage/csi-snapshotter:v8.4.0

     # snapNamePrefix: Prefix to apply to the names of a created snapshots
     # Allowed values: string
@@ -172,6 +153,7 @@ controller:
   # provisioner: allows to provision volumes of CSI drivers
   # csi-provisioner is installed as a sidecar for CSI drivers
   provisioner:
+    image: registry.k8s.io/sig-storage/csi-provisioner:v6.1.0
     ## timeout: Defines the timeout for csi-provisoner sidecar in seconds
     # Allowed values: Number followed by unit (s)
     # Examples: 60s
@@ -185,6 +167,7 @@ controller:
     #   false: disable volume expansion feature(do not install resizer sidecar)
     # Default value: true
     enabled: true
+    image: registry.k8s.io/sig-storage/csi-resizer:v2.0.0

   healthMonitor:
     # enabled: Enable/Disable health monitor of CSI volumes
@@ -193,6 +176,7 @@ controller:
     #   false: disable checking of health condition of CSI volumes
     # Default value: false
     enabled: false
+    image: registry.k8s.io/sig-storage/csi-external-health-monitor-controller:v0.16.0

     # interval: Interval of monitoring volume health condition
     # Allowed values: Number followed by unit (s,m,h)
@@ -209,6 +193,7 @@ controller:
     #   false: disable replication feature(do not install dell-csi-replicator sidecar)
     # Default value: false
     enabled: false
+    image: quay.io/dell/container-storage-modules/dell-csi-replicator:v1.14.0

     # replicationContextPrefix: prefix to use for naming of resources created by replication feature
     # Allowed values: string
@@ -276,6 +261,9 @@ node:
   # Default value: 120s
   volumeDisconnectTimeoutSeconds: "120s"

+  registrar:
+    image: registry.k8s.io/sig-storage/csi-node-driver-registrar:v2.15.0
+
   healthMonitor:
     # enabled: Enable/Disable health monitor of CSI volumes- volume usage, volume condition
     # Allowed values:
@@ -383,6 +371,7 @@ storageCapacity:
 # Enable this feature only after contact support for additional information
 podmon:
   enabled: false
+  image: quay.io/dell/container-storage-modules/podmon:v1.15.0
   controller:
     args:
       - "--csisock=unix:/var/run/csi/csi.sock"
@@ -435,6 +424,7 @@ multiNas:
 # Default value: "false"
 authorization:
   enabled: false
+  image: quay.io/dell/container-storage-modules/csm-authorization-sidecar:v2.4.0
   # proxyHost: hostname of the csm-authorization server
   # Default value: None
   proxyHost:
--
2.34.1
