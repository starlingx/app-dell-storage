From 1cfa360bb954abc46800b2634c4a2b8e95b4b8fd Mon Sep 17 00:00:00 2001
From: Alyson Deives Pereira <alyson.deivespereira@windriver.com>
Date: Fri, 20 Mar 2026 15:04:36 -0300
Subject: [PATCH] csi-powerstore: add snapshotclass in templates

This patch consists of adding a snapshot class in the helm chart
templates directory.
It's needed because this helm chart needs a snapshot class that should
be created manually.

Signed-off-by: Gabriel Przybysz Gonçalves Júnior <gabriel.przybsyzgoncalvesjunior@windriver.com>
Signed-off-by: Alyson Deives Pereira <alyson.deivespereira@windriver.com>
---
 charts/csi-powerstore/templates/snapshotclass.yaml | 6 ++++++
 charts/csi-powerstore/values.yaml                  | 1 +
 2 files changed, 7 insertions(+)
 create mode 100644 charts/csi-powerstore/templates/snapshotclass.yaml

diff --git a/charts/csi-powerstore/templates/snapshotclass.yaml b/charts/csi-powerstore/templates/snapshotclass.yaml
new file mode 100644
index 0000000..e3ab58c
--- /dev/null
+++ b/charts/csi-powerstore/templates/snapshotclass.yaml
@@ -0,0 +1,6 @@
+apiVersion: snapshot.storage.k8s.io/v1
+kind: VolumeSnapshotClass
+metadata:
+  name: {{ .Release.Name }}-snapshot
+driver: {{ .Values.driverName | default ( print "csi-powerstore.dellemc.com" ) }}
+deletionPolicy: {{ .Values.controller.snapshot.deletionPolicy }}
diff --git a/charts/csi-powerstore/values.yaml b/charts/csi-powerstore/values.yaml
index de58334..b74c567 100644
--- a/charts/csi-powerstore/values.yaml
+++ b/charts/csi-powerstore/values.yaml
@@ -150,6 +150,7 @@ controller:
     # Default value: None
     enabled: true
     image: registry.k8s.io/sig-storage/csi-snapshotter:v8.4.0
+    deletionPolicy: Delete

     # snapNamePrefix: Prefix to apply to the names of a created snapshots
     # Allowed values: string
--
2.34.1