From 23e5f25d43d51400580e27d14eafbfe41d863ca6 Mon Sep 17 00:00:00 2001
From: Gustavo Ornaghi Antunes <gustavo.ornaghiantunes@windriver.com>
Date: Fri, 12 Apr 2024 11:15:27 -0300
Subject: [PATCH] csi-powerstore: add snapshotclass in templates

This patch consists of adding a snapshot class in the helm chart
templates directory.
It's needed because this helm chart needs a snapshot class that should
be created manually.

Signed-off-by: Gustavo Ornaghi Antunes <gustavo.ornaghiantunes@windriver.com>
---
 charts/csi-powerstore/templates/snapshotclass.yaml | 6 ++++++
 1 file changed, 6 insertions(+)
 create mode 100644 charts/csi-powerstore/templates/snapshotclass.yaml

diff --git a/charts/csi-powerstore/templates/snapshotclass.yaml b/charts/csi-powerstore/templates/snapshotclass.yaml
new file mode 100644
index 0000000..e3ab58c
--- /dev/null
+++ b/charts/csi-powerstore/templates/snapshotclass.yaml
@@ -0,0 +1,6 @@
+apiVersion: snapshot.storage.k8s.io/v1
+kind: VolumeSnapshotClass
+metadata:
+  name: {{ .Release.Name }}-snapshot
+driver: {{ .Values.driverName | default ( print "csi-powerstore.dellemc.com" ) }}
+deletionPolicy: {{ .Values.controller.snapshot.deletionPolicy }}
-- 
2.34.1

