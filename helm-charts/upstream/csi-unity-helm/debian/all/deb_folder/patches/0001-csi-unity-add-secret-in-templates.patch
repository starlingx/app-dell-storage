From 74dc5b46dc79962d05b0094148f18d4f73927197 Mon Sep 17 00:00:00 2001
From: Guilherme Costa <guilherme.costa@windriver.com>
Date: Fri, 1 Mar 2024 12:33:32 -0300
Subject: [PATCH] csi-unity: add secret in templates

This patch consists of adding a secret in the helm chart templates
directory.
It's needed because this helm chart needs a config secret that should
be created manually.

Signed-off-by: Guilherme Costa <guilherme.costa@windriver.com>
---
 charts/csi-unity/templates/secret.yaml | 18 ++++++++++++++++++
 charts/csi-unity/values.yaml           |  2 ++
 2 files changed, 20 insertions(+)
 create mode 100644 charts/csi-unity/templates/secret.yaml

diff --git a/charts/csi-unity/templates/secret.yaml b/charts/csi-unity/templates/secret.yaml
new file mode 100644
index 0000000..e2cacef
--- /dev/null
+++ b/charts/csi-unity/templates/secret.yaml
@@ -0,0 +1,18 @@
+{{- if .Values.secret }}
+apiVersion: v1
+kind: Secret
+metadata:
+  name: {{ .Release.Name }}-creds
+  namespace: {{ .Release.Namespace }}
+stringData:
+  config: |
+    storageArrayList:
+      {{- range .Values.secret.arrays }}
+      - arrayId: "{{ .arrayId }}"
+        username: "{{ .username }}"
+        password: "{{ .password }}"
+        endpoint: "{{ .endpoint }}"
+        skipCertificateValidation: {{ .skipCertificateValidation | default "true" }}
+        isDefault: {{ .isDefault | default "false" }}
+      {{- end }}
+{{- end }}
diff --git a/charts/csi-unity/values.yaml b/charts/csi-unity/values.yaml
index 5cbb357..d8f74a3 100644
--- a/charts/csi-unity/values.yaml
+++ b/charts/csi-unity/values.yaml
@@ -281,3 +281,5 @@ storageCapacity:
   # Allowed values: 1m,2m,3m,...,10m,...,60m etc
   # Default value: 5m
   pollInterval: 5m
+
+secret:
-- 
2.34.1
