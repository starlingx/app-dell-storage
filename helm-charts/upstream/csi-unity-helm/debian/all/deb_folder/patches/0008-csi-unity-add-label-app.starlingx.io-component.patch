From d80e5b9228120a8d6eb79087100ff0817b7bb427 Mon Sep 17 00:00:00 2001
From: Heitor Farhat <heitor.farhat@windriver.com>
Date: Fri, 20 Mar 2026 14:15:50 -0300
Subject: [PATCH] csi-unity: add label app.starlingx.io/component

This patch consists of changing the strategy from the Deployment
resource and add the app.starlingx.io/component label in all pods.
The strategy was needed changing because in the reapply the old
replicasets were not being deleted. The default value was rollingUpdate.
In this case, it doesn't effect functionality.

Signed-off-by: Heitor Farhat <heitor.farhat@windriver.com>
---
 charts/csi-unity/templates/controller.yaml | 3 +++
 charts/csi-unity/templates/node.yaml       | 1 +
 charts/csi-unity/values.yaml               | 3 +++
 3 files changed, 7 insertions(+)

diff --git a/charts/csi-unity/templates/controller.yaml b/charts/csi-unity/templates/controller.yaml
index 570721e..d90c324 100644
--- a/charts/csi-unity/templates/controller.yaml
+++ b/charts/csi-unity/templates/controller.yaml
@@ -147,12 +147,15 @@ spec:
   selector:
     matchLabels:
       app: {{ .Release.Name }}-controller
+  strategy:
+    type: Recreate
   template:
     metadata:
       annotations:
         kubectl.kubernetes.io/default-container: "driver"
       labels:
         app: {{ .Release.Name }}-controller
+        app.starlingx.io/component: {{ ternary "application" "platform" .Values.labels.isApplication }}
     spec:
       serviceAccountName: {{ .Release.Name }}-controller
       affinity:
diff --git a/charts/csi-unity/templates/node.yaml b/charts/csi-unity/templates/node.yaml
index c6c62a8..cd1863f 100644
--- a/charts/csi-unity/templates/node.yaml
+++ b/charts/csi-unity/templates/node.yaml
@@ -97,6 +97,7 @@ spec:
         kubectl.kubernetes.io/default-container: "driver"
       labels:
         app: {{ .Release.Name }}-node
+        app.starlingx.io/component: {{ ternary "application" "platform" .Values.labels.isApplication }}
 {{- if or .Values.podmon.enabled .Values.csm.resiliency }}
         driver.dellemc.com: dell-storage
 {{- end }}
diff --git a/charts/csi-unity/values.yaml b/charts/csi-unity/values.yaml
index d396680..3317c92 100644
--- a/charts/csi-unity/values.yaml
+++ b/charts/csi-unity/values.yaml
@@ -304,3 +304,6 @@ storageCapacity:
 secret:
 
 storageClasses:
+
+labels:
+  isApplication: false
-- 
2.34.1
