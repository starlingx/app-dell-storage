From 39d715b1e3fb08337282e880bbb24c1c6c364304 Mon Sep 17 00:00:00 2001
From: Guilherme Costa <guilherme.costa@windriver.com>
Date: Fri, 1 Mar 2024 12:36:21 -0300
Subject: [PATCH] csi-unity: add secretcert in templates

This patch consists in add an extra secret containing the https
certificate that is used by the helm chart.

Signed-off-by: Guilherme Costa <guilherme.costa@windriver.com>
---
 charts/csi-unity/templates/secretcert.yaml | 9 +++++++++
 1 file changed, 9 insertions(+)
 create mode 100644 charts/csi-unity/templates/secretcert.yaml

diff --git a/charts/csi-unity/templates/secretcert.yaml b/charts/csi-unity/templates/secretcert.yaml
new file mode 100644
index 0000000..1d64994
--- /dev/null
+++ b/charts/csi-unity/templates/secretcert.yaml
@@ -0,0 +1,9 @@
+{{- if .Values.secret }}
+apiVersion: v1
+kind: Secret
+metadata:
+  name: {{ .Release.Name }}-certs-0
+  namespace: {{ .Release.Namespace }}
+stringData:
+  cert-0: {{ .Values.certSecret | default "" | quote }}
+{{- end }}
-- 
2.34.1
