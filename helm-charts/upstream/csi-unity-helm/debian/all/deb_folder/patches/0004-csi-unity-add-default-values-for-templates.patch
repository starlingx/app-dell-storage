From 57a1b11afca5856703d151fef0ae6a7990b3b0d2 Mon Sep 17 00:00:00 2001
From: Gabriel Przybysz Gonçalves Júnior <gabriel.przybsyzgoncalvesjunior@windriver.com>
Date: Tue, 14 Oct 2025 10:23:00 -0300
Subject: [PATCH] csi-unity: add default values for templates

This patch consists of adding the default values in the values.yaml of
the helm chart.
It's necessary because the images in templates were in unexpected
format for the system and because templates need default values to be
able to build the package.

Signed-off-by: Gabriel Przybysz Gonçalves Júnior <gabriel.przybsyzgoncalvesjunior@windriver.com>
--
 charts/csi-unity/values.yaml | 60 +++++++++++++++++++++++-------------
 1 file changed, 39 insertions(+), 21 deletions(-)

diff --git a/charts/csi-unity/values.yaml b/charts/csi-unity/values.yaml
index f309cc4..3f9c117 100644
--- a/charts/csi-unity/values.yaml
+++ b/charts/csi-unity/values.yaml
@@ -6,27 +6,11 @@
 # Examples : "v2.9.0" , "nightly"
 version: "v2.15.0"

-images:
-  # "driver" defines the container image, used for the driver container.
-  driver:
-    image: quay.io/dell/container-storage-modules/csi-unity:v2.15.0
-  # CSI sidecars
-  attacher:
-    image: registry.k8s.io/sig-storage/csi-attacher:v4.9.0
-  provisioner:
-    image: registry.k8s.io/sig-storage/csi-provisioner:v5.3.0
-  snapshotter:
-    image: registry.k8s.io/sig-storage/csi-snapshotter:v8.3.0
-  resizer:
-    image: registry.k8s.io/sig-storage/csi-resizer:v1.14.0
-  registrar:
-    image: registry.k8s.io/sig-storage/csi-node-driver-registrar:v2.14.0
-  healthmonitor:
-    image: registry.k8s.io/sig-storage/csi-external-health-monitor-controller:v0.15.0
-
-  # CSM sidecars
-  podmon:
-    image: quay.io/dell/container-storage-modules/podmon:v1.14.0
+driver:
+  # image: Image to use for driver sidecar. This shouldn't be changed
+  # Allowed values: string
+  # Default value: quay.io/dell/container-storage-modules/csi-unity:v2.15.0
+  image: quay.io/dell/container-storage-modules/csi-unity:v2.15.0

 # LogLevel is used to set the logging level of the driver.
 # Allowed values: "error", "warn"/"warning", "info", "debug"
@@ -84,6 +68,18 @@ controller:
   # Examples: "k8s", "app1"
   volumeNamePrefix: csivol

+  attacher:
+    # image: Image to use for attacher sidecar. This shouldn't be changed
+    # Allowed values: string
+    # Default value: registry.k8s.io/sig-storage/csi-attacher:v4.9.0
+    image: registry.k8s.io/sig-storage/csi-attacher:v4.9.0
+
+  provisioner:
+    # image: Image to use for provisioner sidecar. This shouldn't be changed
+    # Allowed values: string
+    # Default value: registry.k8s.io/sig-storage/csi-provisioner:v5.3.0
+    image: registry.k8s.io/sig-storage/csi-provisioner:v5.3.0
+
   snapshot:
     # enabled: Enable/Disable volume snapshot feature
     # Allowed values:
@@ -98,6 +94,11 @@ controller:
     # Examples: "snap", "snapshot"
     snapNamePrefix: csi-snap

+    # image: Image to use for snapshotter sidecar. This shouldn't be changed
+    # Allowed values: string
+    # Default value: registry.k8s.io/sig-storage/csi-snapshotter:v8.3.0
+    image: registry.k8s.io/sig-storage/csi-snapshotter:v8.3.0
+
   resizer:
     # enabled: Enable/Disable volume expansion feature
     # Allowed values:
@@ -106,6 +107,11 @@ controller:
     # Default value: None
     enabled: true

+    # image: Image to use for resizer sidecar. This shouldn't be changed
+    # Allowed values: string
+    # Default value: registry.k8s.io/sig-storage/csi-resizer:v1.14.0
+    image: registry.k8s.io/sig-storage/csi-resizer:v1.14.0
+
   # nodeSelector: Define node selection constraints for controller pods.
   # For the pod to be eligible to run on a node, the node must have each
   # of the indicated key-value pairs as labels.
@@ -144,6 +150,11 @@ controller:
     # Default value: 60s
     interval: 60s

+    # image: Image to use for csi-external-health-monitor-controller sidecar. This shouldn't be changed
+    # Allowed values: string
+    # Default value: registry.k8s.io/sig-storage/csi-external-health-monitor-controller:v0.15.0
+    image: registry.k8s.io/sig-storage/csi-external-health-monitor-controller:v0.15.0
+
 # node: configure node pod specific parameters
 node:
   # dnsPolicy : Define the DNS Policy of the Node service.
@@ -153,6 +164,12 @@ node:
   # Default value: None
   dnsPolicy: "ClusterFirstWithHostNet"

+  # image: Image to use for registrar sidecar. This shouldn't be changed
+  # Allowed values: string
+  # Default value: registry.k8s.io/sig-storage/csi-node-driver-registrar:v2.14.0
+  registrar:
+    image: registry.k8s.io/sig-storage/csi-node-driver-registrar:v2.14.0
+
   healthMonitor:
     # enabled: Enable/Disable health monitor of CSI Volumes - volume usage
     # Allowed values:
@@ -221,6 +238,7 @@ podmon:
   # defaule value : None
   # Examples : true , false
   enabled: false
+  image: quay.io/dell/container-storage-modules/podmon:v1.14.0
   controller:
     args:
       - "--csisock=unix:/var/run/csi/csi.sock"
--
2.34.1
