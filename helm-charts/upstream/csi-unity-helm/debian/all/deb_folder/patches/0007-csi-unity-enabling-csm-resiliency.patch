From 6eeee167325602883eb73b0e8e8f6cf954479bd2 Mon Sep 17 00:00:00 2001
From: Gabriel Przybysz Gonçalves Júnior <gabriel.przybsyzgoncalvesjunior@windriver.com>
Date: Fri, 20 Mar 2026 14:15:50 -0300
Subject: [PATCH] csi-unity: enabling csm-resiliency

This patch consists of changing the format of the values in templates
and changing the values.yaml for the user be able to enable
csm-resiliency

Signed-off-by: Gabriel Przybysz Gonçalves Júnior <gabriel.przybsyzgoncalvesjunior@windriver.com>
---
 charts/csi-unity/templates/controller.yaml           |  8 ++++----
 charts/csi-unity/templates/driver-config-params.yaml |  2 +-
 charts/csi-unity/templates/node.yaml                 | 10 +++++-----
 charts/csi-unity/values.yaml                         |  3 +++
 4 files changed, 13 insertions(+), 10 deletions(-)

diff --git a/charts/csi-unity/templates/controller.yaml b/charts/csi-unity/templates/controller.yaml
index 438a122..570721e 100644
--- a/charts/csi-unity/templates/controller.yaml
+++ b/charts/csi-unity/templates/controller.yaml
@@ -17,7 +17,7 @@ rules:
     verbs: ["list", "watch", "create", "update", "patch"]
   - apiGroups: [""]
     resources: ["nodes"]
-{{- if .Values.podmon.enabled }}
+{{- if or .Values.podmon.enabled .Values.csm.resiliency }}
     verbs: ["get", "list", "watch", "patch"]
 {{- else }}
     verbs: ["get", "list", "watch"]
@@ -33,7 +33,7 @@ rules:
     verbs: ["get", "list", "watch"]
   - apiGroups: ["storage.k8s.io"]
     resources: ["volumeattachments"]
-{{- if .Values.podmon.enabled }}
+{{- if or .Values.podmon.enabled .Values.csm.resiliency}}
     verbs: ["get", "list", "watch", "patch", "delete"]
 {{- else }}
     verbs: ["get", "list", "watch", "patch"]
@@ -46,7 +46,7 @@ rules:
     verbs: ["patch"]
   - apiGroups: [""]
     resources: ["pods"]
-{{- if .Values.podmon.enabled }}
+{{- if or .Values.podmon.enabled .Values.csm.resiliency }}
     verbs: ["get", "list", "watch", "delete"]
 {{- else }}
     verbs: ["get", "list", "watch"]
@@ -174,7 +174,7 @@ spec:
       {{- toYaml .Values.controller.tolerations | nindent 6 }}
       {{- end }}
       containers:
-{{- if .Values.podmon.enabled }}
+{{- if or .Values.podmon.enabled .Values.csm.resiliency}}
         - name: podmon
           imagePullPolicy: {{ .Values.imagePullPolicy }}
           image: {{ required "Must provide the podmon container image." .Values.podmon.image }}
diff --git a/charts/csi-unity/templates/driver-config-params.yaml b/charts/csi-unity/templates/driver-config-params.yaml
index 2bbf894..66032e0 100644
--- a/charts/csi-unity/templates/driver-config-params.yaml
+++ b/charts/csi-unity/templates/driver-config-params.yaml
@@ -10,7 +10,7 @@ data:
     MAX_UNITY_VOLUMES_PER_NODE: "{{ .Values.maxUnityVolumesPerNode }}"
     SYNC_NODE_INFO_TIME_INTERVAL: "{{ .Values.syncNodeInfoInterval }}"
     TENANT_NAME: "{{ .Values.tenantName }}"
-    {{ if .Values.podmon.enabled }}
+    {{ if or .Values.podmon.enabled .Values.csm.resiliency }}
     PODMON_CONTROLLER_LOG_LEVEL: "{{ .Values.logLevel }}"
     PODMON_CONTROLLER_LOG_FORMAT: "TEXT"
     PODMON_NODE_LOG_LEVEL: "{{ .Values.logLevel }}"
diff --git a/charts/csi-unity/templates/node.yaml b/charts/csi-unity/templates/node.yaml
index 7298c6f..c6c62a8 100644
--- a/charts/csi-unity/templates/node.yaml
+++ b/charts/csi-unity/templates/node.yaml
@@ -31,7 +31,7 @@ rules:
     resourceNames: [ "privileged" ]
     resources: [ "securitycontextconstraints" ]
     verbs: [ "use" ]
-{{- if .Values.podmon.enabled }}
+{{- if or .Values.podmon.enabled .Values.csm.resiliency }}
   - apiGroups: [ "" ]
     resources: [ "pods" ]
     verbs: [ "get", "list", "watch" ]
@@ -50,7 +50,7 @@ roleRef:
   kind: ClusterRole
   name: {{ .Release.Name }}-node
   apiGroup: rbac.authorization.k8s.io
-{{- if .Values.podmon.enabled }}
+{{- if or .Values.podmon.enabled .Values.csm.resiliency }}
 ---
 # Role for Driver-specific Permissions in a Namespace
 kind: Role
@@ -97,7 +97,7 @@ spec:
         kubectl.kubernetes.io/default-container: "driver"
       labels:
         app: {{ .Release.Name }}-node
-{{- if .Values.podmon.enabled }}
+{{- if or .Values.podmon.enabled .Values.csm.resiliency }}
         driver.dellemc.com: dell-storage
 {{- end }}
     spec:
@@ -114,7 +114,7 @@ spec:
       hostNetwork: true
       dnsPolicy: {{ .Values.node.dnsPolicy }}
       containers:
-{{- if .Values.podmon.enabled }}
+{{- if or .Values.podmon.enabled .Values.csm.resiliency }}
         - name: podmon
           securityContext:
             privileged: true
@@ -290,7 +290,7 @@ spec:
         - name: unity-secret
           secret:
               secretName: {{ .Release.Name }}-creds
-{{- if .Values.podmon.enabled }}
+{{- if or .Values.podmon.enabled .Values.csm.resiliency }}
         - name: usr-bin
           hostPath:
             path: /usr/bin
diff --git a/charts/csi-unity/values.yaml b/charts/csi-unity/values.yaml
index c56b259..d396680 100644
--- a/charts/csi-unity/values.yaml
+++ b/charts/csi-unity/values.yaml
@@ -1,6 +1,9 @@
 ## K8S/DRIVER ATTRIBUTES
 ########################

+csm:
+  resiliency: false
+
 # version: version of this values file
 # Note: Do not change this value
 # Examples : "v2.16.0" , "nightly"
--
2.34.1
