From 0f27ba3ca33bd5285efac16c7da69f5b69b25659 Mon Sep 17 00:00:00 2001
From: Heitor Farhat <heitor.farhat@windriver.com>
Date: Tue, 17 Dec 2024 08:42:28 -0300
Subject: [PATCH] csi-powerflex: adding list permissions to csinodes

This patch consists of adding list permissions
to csinodes from storage.k8s.io api group.

Signed-off-by: Heitor Farhat <heitor.farhat@windriver.com>
---
 charts/csi-vxflexos/templates/node.yaml | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/charts/csi-vxflexos/templates/node.yaml b/charts/csi-vxflexos/templates/node.yaml
index 76b5aa6..02e0b48 100644
--- a/charts/csi-vxflexos/templates/node.yaml
+++ b/charts/csi-vxflexos/templates/node.yaml
@@ -26,6 +26,9 @@ rules:
   - apiGroups: ["storage.k8s.io"]
     resources: ["volumeattachments"]
     verbs: ["get", "list", "watch", "update"]
+  - apiGroups: ["storage.k8s.io"]
+    resources: ["csinodes"]
+    verbs: ["get", "list", "watch", "update"]
   - apiGroups: ["storage.k8s.io"]
     resources: ["storageclasses"]
     verbs: ["get", "list", "watch"]
-- 
2.34.1

