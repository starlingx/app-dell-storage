From 6c7d0d5f1d8e8e1ade035c9ca291d1084041c497 Mon Sep 17 00:00:00 2001
From: Gabriel Przybysz Gonçalves Júnior <gabriel.przybsyzgoncalvesjunior@windriver.com>
Date: Fri, 20 Mar 2026 14:15:57 -0300
Subject: [PATCH] csm-observability: fix all image paths

This patch consists of changing the format to use the image path
directly following the expected format used by kube_app and add
docker.io prefix in image path to prevent future issues.

Signed-off-by: Gabriel Przybysz Gonçalves Júnior <gabriel.przybsyzgoncalvesjunior@windriver.com>
---
 .../templates/karavi-metrics-powerflex.yaml                  | 2 +-
 .../templates/karavi-metrics-powermax.yaml                   | 2 +-
 .../templates/karavi-metrics-powerscale.yaml                 | 2 +-
 charts/karavi-observability/values.yaml                      | 5 ++++-
 4 files changed, 7 insertions(+), 4 deletions(-)

diff --git a/charts/karavi-observability/templates/karavi-metrics-powerflex.yaml b/charts/karavi-observability/templates/karavi-metrics-powerflex.yaml
index 6db550a..208cbe2 100644
--- a/charts/karavi-observability/templates/karavi-metrics-powerflex.yaml
+++ b/charts/karavi-observability/templates/karavi-metrics-powerflex.yaml
@@ -74,7 +74,7 @@ spec:
       {{- if eq .Values.karaviMetricsPowerflex.authorization.enabled true }}
       - name: karavi-authorization-proxy
         imagePullPolicy: IfNotPresent
-        image: {{ required "Must provide the authorization sidecar container image." .Values.karaviMetricsPowerflex.authorization.sidecarProxy.image }}
+        image: {{ required "Must provide the authorization sidecar container image." .Values.sidecarProxy.image }}
         env:
           - name: PROXY_HOST
             value: "{{ .Values.karaviMetricsPowerflex.authorization.proxyHost }}"
diff --git a/charts/karavi-observability/templates/karavi-metrics-powermax.yaml b/charts/karavi-observability/templates/karavi-metrics-powermax.yaml
index 89cf8da..ef1037d 100644
--- a/charts/karavi-observability/templates/karavi-metrics-powermax.yaml
+++ b/charts/karavi-observability/templates/karavi-metrics-powermax.yaml
@@ -88,7 +88,7 @@ spec:
       {{- if eq .Values.karaviMetricsPowermax.authorization.enabled true }}
       - name: karavi-authorization-proxy
         imagePullPolicy: IfNotPresent
-        image: {{ required "Must provide the authorization sidecar container image." .Values.karaviMetricsPowermax.authorization.sidecarProxy.image }}
+        image: {{ required "Must provide the authorization sidecar container image." .Values.sidecarProxy.image }}
         env:
           - name: PROXY_HOST
             value: "{{ .Values.karaviMetricsPowermax.authorization.proxyHost }}"
diff --git a/charts/karavi-observability/templates/karavi-metrics-powerscale.yaml b/charts/karavi-observability/templates/karavi-metrics-powerscale.yaml
index f71e51d..0cf926f 100644
--- a/charts/karavi-observability/templates/karavi-metrics-powerscale.yaml
+++ b/charts/karavi-observability/templates/karavi-metrics-powerscale.yaml
@@ -74,7 +74,7 @@ spec:
       {{- if eq .Values.karaviMetricsPowerscale.authorization.enabled true }}
       - name: karavi-authorization-proxy
         imagePullPolicy: IfNotPresent
-        image: {{ required "Must provide the authorization sidecar container image." .Values.karaviMetricsPowerscale.authorization.sidecarProxy.image }}
+        image: {{ required "Must provide the authorization sidecar container image." .Values.sidecarProxy.image }}
         env:
           - name: PROXY_HOST
             value: "{{ .Values.karaviMetricsPowerscale.authorization.proxyHost }}"
diff --git a/charts/karavi-observability/values.yaml b/charts/karavi-observability/values.yaml
index 7d86fa9..3cfe554 100644
--- a/charts/karavi-observability/values.yaml
+++ b/charts/karavi-observability/values.yaml
@@ -209,7 +209,7 @@ otelCollector:
   service:
     type: ClusterIP
   nginxProxy:
-    image: nginxinc/nginx-unprivileged:1.29
+    image: docker.io/nginxinc/nginx-unprivileged:1.29.8
 # Karavi-observability requires cert-manager. If cert-manager is already present in cluster, set enabled to false not to install it.
 cert-manager:
   enabled: true
@@ -219,3 +219,6 @@ cert-manager:
       create: false
 # Optionally, uncomment and specify the name of the pre-created namespace to install the module in it
 # namespace:
+
+sidecarProxy:
+  image: quay.io/dell/container-storage-modules/csm-authorization-sidecar:v2.4.0
-- 
2.34.1

