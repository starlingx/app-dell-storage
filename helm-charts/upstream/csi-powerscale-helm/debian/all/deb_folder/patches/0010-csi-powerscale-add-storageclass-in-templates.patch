From 0971c19b90e1dd5a029dcfebfd2fc035ca756a7e Mon Sep 17 00:00:00 2001
From: Gustavo Ornaghi Antunes <gustavo.ornaghiantunes@windriver.com>
Date: Fri, 20 Dec 2024 10:43:28 -0300
Subject: [PATCH] csi-powerscale: add storageclass in templates

This patch consists of adding a storage classes in the helm chart
templates directory.
It's needed because this helm chart needs a storage classes that should
be created manually.

Signed-off-by: Gustavo Ornaghi Antunes <gustavo.ornaghiantunes@windriver.com>
---
 charts/csi-isilon/templates/storageclass.yaml | 67 +++++++++++++++++++
 1 file changed, 67 insertions(+)
 create mode 100644 charts/csi-isilon/templates/storageclass.yaml

diff --git a/charts/csi-isilon/templates/storageclass.yaml b/charts/csi-isilon/templates/storageclass.yaml
new file mode 100644
index 0000000..43c0d79
--- /dev/null
+++ b/charts/csi-isilon/templates/storageclass.yaml
@@ -0,0 +1,67 @@
+{{- range $sc := $.Values.storageClasses }}
+apiVersion: storage.k8s.io/v1
+kind: StorageClass
+metadata:
+  name: {{ $sc.name | lower }}
+provisioner: {{ $sc.provisioner | default "csi-isilon.dellemc.com" }}
+reclaimPolicy: {{ $sc.reclaimPolicy | default "Delete" }}
+allowVolumeExpansion: {{ $sc.allowVolumeExpansion | default true }}
+parameters:
+  AccessZone: {{ $sc.AccessZone | default $.Values.isiAccessZone }}
+  IsiPath: {{ $sc.IsiPath | default $.Values.isiPath }}
+  IsiVolumePathPermissions: {{ $sc.IsiVolumePathPermissions | default "0777" | quote }}
+{{- if hasKey $sc "AzServiceIP" }}
+  AzServiceIP: {{ $sc.AzServiceIP }}
+{{- end }}
+  RootClientEnabled: {{ $sc.RootClientEnabled | default false | quote }}
+{{- if hasKey $sc "ClusterName" }}
+  ClusterName: {{ $sc.ClusterName | quote }}
+{{- end }}
+{{- if or $.Values.controller.replication.enabled $.Values.csm.replication }}
+{{- $prefix := $.Values.controller.replication.replicationPrefix -}}
+{{- if hasKey $sc "replication" }}
+  {{ printf "%s/isReplicationEnabled" $prefix }}: {{ $sc.replication.isReplicationEnabled | default true | quote }}
+{{- if hasKey $sc.replication "remoteStorageClassName" }}
+  {{ printf "%s/remoteStorageClassName" $prefix }}: {{ $sc.replication.remoteStorageClassName | quote }}
+{{- end}}
+{{- if hasKey $sc.replication "remoteClusterID" }}
+  {{ printf "%s/remoteClusterID" $prefix }}: {{ $sc.replication.remoteClusterID | quote }}
+{{- end}}
+{{- if hasKey $sc.replication "remoteSystem" }}
+  {{ printf "%s/remoteSystem" $prefix }}: {{ $sc.replication.remoteSystem | quote }}
+{{- end}}
+{{- if hasKey $sc.replication "rpo" }}
+  {{ printf "%s/rpo" $prefix }}: {{ $sc.replication.rpo | quote }}
+{{- end}}
+{{- if hasKey $sc.replication "ignoreNamespaces" }}
+  {{ printf "%s/ignoreNamespaces" $prefix }}: {{ $sc.replication.ignoreNamespaces | quote }}
+{{- end}}
+{{- if hasKey $sc.replication "volumeGroupPrefix" }}
+  {{ printf "%s/volumeGroupPrefix" $prefix }}: {{ $sc.replication.volumeGroupPrefix | quote }}
+{{- end}}
+  {{ printf "%s/remoteAccessZone" $prefix }}: {{ $sc.replication.remoteAccessZone | default $.Values.isiAccessZone | quote }}
+{{- if hasKey $sc.replication "remoteAzServiceIP" }}
+  {{ printf "%s/remoteAzServiceIP" $prefix }}: {{ $sc.replication.remoteAzServiceIP | quote }}
+{{- end}}
+  {{ printf "%s/remoteRootClientEnabled" $prefix }}: {{ $sc.replication.remoteRootClientEnabled | default false | quote }}
+{{- end }}
+{{- end }}
+{{- if hasKey $sc "AdvisoryLimit" }}
+  AdvisoryLimit: {{ $sc.AdvisoryLimit | quote }}
+{{- end }}
+{{- if hasKey $sc "SoftLimit" }}
+  SoftLimit: {{ $sc.SoftLimit | quote }}
+{{- end }}
+{{- if hasKey $sc "SoftGracePrd" }}
+  SoftGracePrd: {{ $sc.SoftGracePrd | quote }}
+{{- end }}
+  csi.storage.k8s.io/fstype: {{ $sc.fstype | default "nfs" | quote }}
+volumeBindingMode: {{ $sc.volumeBindingMode | default "Immediate" | quote }}
+{{- if hasKey $sc "allowedTopologies" }}
+allowedTopologies: {{ $sc.allowedTopologies | toYaml | nindent 2 }}
+{{- end }}
+{{- if hasKey $sc "mountOptions" }}
+mountOptions: {{ $sc.mountOptions }}
+{{- end }}
+---
+{{- end }}
-- 
2.34.1
