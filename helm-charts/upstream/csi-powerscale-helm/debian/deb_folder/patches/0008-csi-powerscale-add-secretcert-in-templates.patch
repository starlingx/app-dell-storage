From bb94d370fe7b56cf9da2082e39e66e83180df76e Mon Sep 17 00:00:00 2001
From: Guilherme Costa <guilherme.costa@windriver.com>
Date: Tue, 2 Apr 2024 17:33:32 -0300
Subject: [PATCH] csi-powerscale: add secretcert in templates

This patch consists in add an extra secret containing the https
certificate that is used by the helm chart.

Signed-off-by: Guilherme Costa <guilherme.costa@windriver.com>
---
 charts/csi-isilon/templates/secretcert.yaml | 10 ++++++++++
 1 file changed, 10 insertions(+)
 create mode 100644 charts/csi-isilon/templates/secretcert.yaml

diff --git a/charts/csi-isilon/templates/secretcert.yaml b/charts/csi-isilon/templates/secretcert.yaml
new file mode 100644
index 0000000..0e5ebce
--- /dev/null
+++ b/charts/csi-isilon/templates/secretcert.yaml
@@ -0,0 +1,10 @@
+{{- if .Values.secret }}
+apiVersion: v1
+kind: Secret
+metadata:
+  name: {{ .Release.Name }}-certs-0
+  namespace: {{ .Release.Namespace }}
+type: Opaque
+stringData:
+  cert-0: {{ .Values.certSecret | default "" | quote }}
+{{- end }}
-- 
2.34.1

