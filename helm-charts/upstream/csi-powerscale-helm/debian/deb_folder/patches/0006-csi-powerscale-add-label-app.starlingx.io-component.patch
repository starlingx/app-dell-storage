From ea55c24dbed1982ee4a70aca8678c50dfb3033af Mon Sep 17 00:00:00 2001
From: Guilherme Costa <guilherme.costa@windriver.com>
Date: Tue, 2 Apr 2024 17:19:45 -0300
Subject: [PATCH] csi-powerscale: add label app.starlingx.io/component

This patch consists of changing the strategy from the Deployment
resource and add the app.starlingx.io/component label in all pods.
The strategy was needed changing because in the reapply the old
replicasets were not being deleted. The default value was rollingUpdate.
In this case, it doesn't affect functionality.

Signed-off-by: Guilherme Costa <guilherme.costa@windriver.com>
---
 charts/csi-isilon/templates/controller.yaml | 5 ++---
 charts/csi-isilon/templates/node.yaml       | 1 +
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/charts/csi-isilon/templates/controller.yaml b/charts/csi-isilon/templates/controller.yaml
index bdeaac5..172ff8a 100644
--- a/charts/csi-isilon/templates/controller.yaml
+++ b/charts/csi-isilon/templates/controller.yaml
@@ -151,13 +151,12 @@ spec:
   replicas: {{ required "Must provide the number of controller instances to create." .Values.controller.controllerCount }}
   {{- end }}
   strategy:
-    type: RollingUpdate
-    rollingUpdate:
-      maxUnavailable: 1
+    type: Recreate
   template:
     metadata:
       labels:
         app: {{ .Release.Name }}-controller
+        app.starlingx.io/component: {{ index .Values "app.starlingx.io/component" }}
     spec:
       serviceAccount: {{ .Release.Name }}-controller
       affinity:
diff --git a/charts/csi-isilon/templates/node.yaml b/charts/csi-isilon/templates/node.yaml
index fde6b0a..d81d535 100644
--- a/charts/csi-isilon/templates/node.yaml
+++ b/charts/csi-isilon/templates/node.yaml
@@ -79,6 +79,7 @@ spec:
     metadata:
       labels:
         app: {{ .Release.Name }}-node
+        app.starlingx.io/component: {{ index .Values "app.starlingx.io/component" }}
 {{- if .Values.podmon.enabled }}
         driver.dellemc.com: dell-storage
 {{- end }}
-- 
2.34.1

