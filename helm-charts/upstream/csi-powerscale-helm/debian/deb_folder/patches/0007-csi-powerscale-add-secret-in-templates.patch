From cd5e206b2ee88db9480cf0ac4115bedaa31a34b4 Mon Sep 17 00:00:00 2001
From: Guilherme Costa <guilherme.costa@windriver.com>
Date: Tue, 2 Apr 2024 16:59:14 -0300
Subject: [PATCH] csi-powerscale: add secret in templates

This patch consists of adding a secret in the helm chart templates
directory. It's needed because this helm chart needs a config secret
that should be created manually.

Signed-off-by: Guilherme Costa <guilherme.costa@windriver.com>
---
 charts/csi-isilon/templates/secret.yaml | 23 +++++++++++++++++++++++
 charts/csi-isilon/values.yaml           |  1 +
 2 files changed, 24 insertions(+)
 create mode 100644 charts/csi-isilon/templates/secret.yaml

diff --git a/charts/csi-isilon/templates/secret.yaml b/charts/csi-isilon/templates/secret.yaml
new file mode 100644
index 0000000..376f8c8
--- /dev/null
+++ b/charts/csi-isilon/templates/secret.yaml
@@ -0,0 +1,23 @@
+{{- if .Values.secret }}
+apiVersion: v1
+kind: Secret
+metadata:
+  name: {{ .Release.Name }}-creds
+  namespace: {{ .Release.Namespace }}
+stringData:
+  config: |
+    isilonClusters:
+      {{- range .Values.secret.arrays }}
+      - clusterName: "{{ .clusterName }}"
+        username: "{{ .username }}"
+        password: "{{ .password }}"
+        endpoint: "{{ .endpoint }}"
+        endpointPort: {{ .endpointPort | default 8080 }}
+        isDefault: {{ .isDefault | default false }}
+        skipCertificateValidation: {{ .skipCertificateValidation | default true }}
+        isiPath: "{{ .isiPath | default $.Values.isiPath }}"
+        isiVolumePathPermissions: {{ .isiVolumePathPermissions | default "0777" | quote}}
+        ignoreUnresolvableHosts: {{ .ignoreUnresolvableHosts | default false }}
+        replicationCertificateID: {{ .replicationCertificateID | default "" | quote }}
+      {{- end }}
+{{- end }}
diff --git a/charts/csi-isilon/values.yaml b/charts/csi-isilon/values.yaml
index b127662..35183e4 100644
--- a/charts/csi-isilon/values.yaml
+++ b/charts/csi-isilon/values.yaml
@@ -494,3 +494,4 @@ encryption:
   # See the gocryptfs documentation for more details.
   extraArgs: []
 
+secret:
-- 
2.34.1

