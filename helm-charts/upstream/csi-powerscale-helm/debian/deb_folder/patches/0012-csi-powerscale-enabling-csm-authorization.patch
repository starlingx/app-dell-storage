diff --git a/charts/csi-isilon/templates/validation.yaml b/charts/csi-isilon/templates/validation.yaml
index cf41b56..420c050 100644
--- a/charts/csi-isilon/templates/validation.yaml
+++ b/charts/csi-isilon/templates/validation.yaml
@@ -1,5 +1,5 @@
 {{- if .Values.encryption.enabled }}
-{{- if .Values.authorization.enabled }}
