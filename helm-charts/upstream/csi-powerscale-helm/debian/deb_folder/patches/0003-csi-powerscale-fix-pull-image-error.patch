From 60308b8d90286098579c5386cb60a8503a6073c9 Mon Sep 17 00:00:00 2001
From: Guilherme Costa <guilherme.costa@windriver.com>
Date: Tue, 2 Apr 2024 13:32:07 -0300
Subject: [PATCH] csi-powerscale: fix pull image error

This patch consists of adding imagePullSecrets with name
default-registry-key only in ServiceAccounts.
It's necessary because without it the system can't use the
images from the registry local

Signed-off-by: Guilherme Costa <guilherme.costa@windriver.com>
---
 charts/csi-isilon/templates/controller.yaml | 2 ++
 charts/csi-isilon/templates/node.yaml       | 2 ++
 2 files changed, 4 insertions(+)

diff --git a/charts/csi-isilon/templates/controller.yaml b/charts/csi-isilon/templates/controller.yaml
index 53d5611..709ed86 100644
--- a/charts/csi-isilon/templates/controller.yaml
+++ b/charts/csi-isilon/templates/controller.yaml
@@ -3,6 +3,8 @@ kind: ServiceAccount
 metadata:
   name: {{ .Release.Name }}-controller
   namespace: {{ .Release.Namespace }}
+imagePullSecrets:
+  - name: default-registry-key
 ---
 kind: ClusterRole
 apiVersion: rbac.authorization.k8s.io/v1
diff --git a/charts/csi-isilon/templates/node.yaml b/charts/csi-isilon/templates/node.yaml
index f7292aa..81edf67 100644
--- a/charts/csi-isilon/templates/node.yaml
+++ b/charts/csi-isilon/templates/node.yaml
@@ -3,6 +3,8 @@ kind: ServiceAccount
 metadata:
   name: {{ .Release.Name }}-node
   namespace: {{ .Release.Namespace }}
+imagePullSecrets:
+  - name: default-registry-key
 ---
 kind: ClusterRole
 apiVersion: rbac.authorization.k8s.io/v1
-- 
2.34.1

