From cd08ec51d71689b5d4454fbac7fa701c474c2857 Mon Sep 17 00:00:00 2001
From: Gabriel Przybysz Gonçalves Júnior <gabriel.przybsyzgoncalvesjunior@windriver.com>
Date: Fri, 28 Mar 2025 07:57:40 -0300
Subject: [PATCH] csi-powerscale: add default values for templates

This patch consists of adding the default values in the values.yaml of
the helm chart.
It's necessary because the images in templates were in unexpected format
for the system and because templates need default values to be able
to build the package.

Signed-off-by: Gabriel Przybysz Gonçalves Júnior <gabriel.przybsyzgoncalvesjunior@windriver.com>
---
 charts/csi-isilon/values.yaml | 73 ++++++++++++++++++++++-------------
 1 file changed, 47 insertions(+), 26 deletions(-)

diff --git a/charts/csi-isilon/values.yaml b/charts/csi-isilon/values.yaml
index c83035c..7f717bc 100644
--- a/charts/csi-isilon/values.yaml
+++ b/charts/csi-isilon/values.yaml
@@ -4,33 +4,19 @@
 # Note: Do not change this value
 version: "v2.13.0"

-images:
-  # "driver" defines the container image, used for the driver container.
-  driver:
-    image: quay.io/dell/container-storage-modules/csi-isilon:v2.13.0
-  # CSI sidecars
-  attacher:
-    image: registry.k8s.io/sig-storage/csi-attacher:v4.8.0
-  provisioner:
-    image: registry.k8s.io/sig-storage/csi-provisioner:v5.1.0
-  snapshotter:
-    image: registry.k8s.io/sig-storage/csi-snapshotter:v8.2.0
-  resizer:
-    image: registry.k8s.io/sig-storage/csi-resizer:v1.13.1
-  registrar:
-    image: registry.k8s.io/sig-storage/csi-node-driver-registrar:v2.13.0
-  healthmonitor:
-    image: registry.k8s.io/sig-storage/csi-external-health-monitor-controller:v0.14.0
+csm:
+  authorization: false
+  resiliency: false
+  replication: false

-  # CSM sidecars
-  replication:
-    image: quay.io/dell/container-storage-modules/dell-csi-replicator:v1.11.0
-  podmon:
-    image: quay.io/dell/container-storage-modules/podmon:v1.12.0
-  authorization:
-    image: quay.io/dell/container-storage-modules/csm-authorization-sidecar:v2.1.0
-  metadataretriever:
-    image: quay.io/dell/container-storage-modules/csi-metadata-retriever:v1.10.0
+labels:
+  isApplication: false
+
+driverName: "csi-isilon.dellemc.com"
+
+# "driver" defines the container image, used for the driver container.
+driver:
+  image: quay.io/dell/container-storage-modules/csi-isilon:v2.13.0

 # CSI driver log level
 # Allowed values: "error", "warn"/"warning", "info", "debug"
@@ -122,6 +108,15 @@ controller:
   # Examples: "k8s", "app1"
   volumeNamePrefix: csivol

+  attacher:
+    image: registry.k8s.io/sig-storage/csi-attacher:v4.8.0
+
+  provisioner:
+    image: registry.k8s.io/sig-storage/csi-provisioner:v5.1.0
+
+  metadataretriever:
+    image: quay.io/dell/container-storage-modules/csi-metadata-retriever:v1.10.0
+
   # leaderElection: configure leader election parameters
   leaderElection:
     # Duration, that non-leader candidates will wait to force acquire leadership
@@ -149,6 +144,8 @@ controller:
     # Default value: false
     enabled: false

+    image: quay.io/dell/container-storage-modules/dell-csi-replicator:v1.11.0
+
     # replicationContextPrefix: prefix to use for naming of resources created by replication feature
     # Allowed values: string
     # Default value: powerscale
@@ -167,6 +164,8 @@ controller:
     # Default value: None
     enabled: true

+    image: registry.k8s.io/sig-storage/csi-snapshotter:v8.2.0
+
     # snapNamePrefix: Prefix to apply to the names of a created snapshots
     # Allowed values: string
     # Default value: csi-snap
@@ -181,6 +180,8 @@ controller:
     # Default value: None
     enabled: true

+    image: registry.k8s.io/sig-storage/csi-resizer:v1.13.1
+
   healthMonitor:
     # enabled: Enable/Disable health monitor of CSI volumes- volume status, volume condition
     # Allowed values:
@@ -189,6 +190,8 @@ controller:
     # Default value: None
     enabled: false

+    image: registry.k8s.io/sig-storage/csi-external-health-monitor-controller:v0.14.0
+
     # interval: Interval of monitoring volume health condition
     # Allowed values: Number followed by unit of time (s,m,h)
     # Default value: 60s
@@ -290,6 +293,9 @@ node:
   # In certain scenarios, users might need to change the default dnsPolicy.
   dnsPolicy: ClusterFirstWithHostNet

+  registrar:
+    image: registry.k8s.io/sig-storage/csi-node-driver-registrar:v2.13.0
+
   healthMonitor:
     # enabled: Enable/Disable health monitor of CSI volumes- volume usage, volume condition
     # Allowed values:
@@ -380,9 +386,15 @@ autoProbe: true

 authorization:
   enabled: false
+
+  image: quay.io/dell/container-storage-modules/csm-authorization-sidecar:v2.1.0
+
   # proxyHost: hostname of the csm-authorization server
   # Default value: None
   proxyHost:
+  # rootCertificate: certificate used to communicate with the csm-authorization server
+  # Default value: None
+  rootCertificate:
   # skipCertificateValidation: certificate validation of the csm-authorization server
   # Allowed Values:
   #   "true" - TLS certificate verification will be skipped
@@ -407,6 +419,7 @@ storageCapacity:
 # Enable this feature only after contact support for additional information
 podmon:
   enabled: false
+  image: quay.io/dell/container-storage-modules/podmon:v1.12.0
   controller:
     args:
       - "--csisock=unix:/var/run/csi/csi.sock"
@@ -430,3 +443,11 @@ podmon:
       - "--driver-config-params=/csi-isilon-config-params/driver-config-params.yaml"
       - "--driverPodLabelValue=dell-storage"
       - "--ignoreVolumelessPods=false"
+
+secret:
+
+storageClasses:
+
+snapshotClasses:
+
+proxyAuthzTokens:
--
2.34.1
