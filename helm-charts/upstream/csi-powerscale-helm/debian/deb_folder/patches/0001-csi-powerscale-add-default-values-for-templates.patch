From 2df9d95f6391cd9b4ae771a5f3a4865ab20dd0d3 Mon Sep 17 00:00:00 2001
From: Gustavo Ornaghi Antunes <gustavo.ornaghiantunes@windriver.com>
Date: Fri, 20 Dec 2024 07:57:40 -0300
Subject: [PATCH] csi-powerscale: add default values for templates

This patch consists of adding the default values in the values.yaml of
the helm chart.
It's necessary because the images in templates were in unexpected format
for the system and because templates need default values to be able
to build the package.

Signed-off-by: Gustavo Ornaghi Antunes <gustavo.ornaghiantunes@windriver.com>
---
 charts/csi-isilon/values.yaml | 72 ++++++++++++++++++++++-------------
 1 file changed, 46 insertions(+), 26 deletions(-)

diff --git a/charts/csi-isilon/values.yaml b/charts/csi-isilon/values.yaml
index b785a3d..92029ab 100644
--- a/charts/csi-isilon/values.yaml
+++ b/charts/csi-isilon/values.yaml
@@ -4,33 +4,19 @@
 # Note: Do not change this value
 version: "v2.12.0"
 
-images:
-  # "driver" defines the container image, used for the driver container.
-  driver:
-    image: quay.io/dell/container-storage-modules/csi-isilon:v2.12.0
-  # CSI sidecars
-  attacher:
-    image: registry.k8s.io/sig-storage/csi-attacher:v4.7.0
-  provisioner:
-    image: registry.k8s.io/sig-storage/csi-provisioner:v5.1.0
-  snapshotter:
-    image: registry.k8s.io/sig-storage/csi-snapshotter:v8.1.0
-  resizer:
-    image: registry.k8s.io/sig-storage/csi-resizer:v1.12.0
-  registrar:
-    image: registry.k8s.io/sig-storage/csi-node-driver-registrar:v2.12.0
-  healthmonitor:
-    image: registry.k8s.io/sig-storage/csi-external-health-monitor-controller:v0.13.0
+csm:
+  authorization: false
+  resiliency: false
+  replication: false
 
-  # CSM sidecars
-  replication:
-    image: quay.io/dell/container-storage-modules/dell-csi-replicator:v1.10.0
-  podmon:
-    image: quay.io/dell/container-storage-modules/podmon:v1.11.0
-  authorization:
-    image: quay.io/dell/container-storage-modules/csm-authorization-sidecar:v1.12.0
-  metadataretriever:
-    image: quay.io/dell/container-storage-modules/csi-metadata-retriever:v1.9.0
+labels:
+  isApplication: false
+
+driverName: "csi-isilon.dellemc.com"
+
+# "driver" defines the container image, used for the driver container.
+driver:
+  image: quay.io/dell/container-storage-modules/csi-isilon:v2.12.0
 
 # CSI driver log level
 # Allowed values: "error", "warn"/"warning", "info", "debug"
@@ -121,6 +107,15 @@ controller:
   # Default value: None
   volumeNamePrefix: k8s
 
+  attacher:
+    image: registry.k8s.io/sig-storage/csi-attacher:v4.7.0
+
+  provisioner:
+    image: registry.k8s.io/sig-storage/csi-provisioner:v5.1.0
+
+  metadataretriever:
+    image: quay.io/dell/container-storage-modules/csi-metadata-retriever:v1.9.0
+
   # leaderElection: configure leader election parameters
   leaderElection:
     # Duration, that non-leader candidates will wait to force acquire leadership
@@ -148,6 +143,8 @@ controller:
     # Default value: false
     enabled: false
 
+    image: quay.io/dell/container-storage-modules/dell-csi-replicator:v1.10.0
+
     # replicationContextPrefix: prefix to use for naming of resources created by replication feature
     # Allowed values: string
     # Default value: powerscale
@@ -166,6 +163,8 @@ controller:
     # Default value: None
     enabled: true
 
+    image: registry.k8s.io/sig-storage/csi-snapshotter:v8.1.0
+
     # snapNamePrefix: Prefix to apply to the names of a created snapshots
     # Allowed values: string
     # Default value: None
@@ -178,6 +177,7 @@ controller:
     #   false: disable volume snapshot feature(do not install resizer sidecar)
     # Default value: None
     enabled: true
+    image: registry.k8s.io/sig-storage/csi-resizer:v1.12.0
 
   healthMonitor:
     # enabled: Enable/Disable health monitor of CSI volumes- volume status, volume condition
@@ -187,6 +187,8 @@ controller:
     # Default value: None
     enabled: false
 
+    image: registry.k8s.io/sig-storage/csi-external-health-monitor-controller:v0.13.0
+
     # interval: Interval of monitoring volume health condition
     # Allowed values: Number followed by unit of time (s,m,h)
     # Default value: 60s
@@ -288,6 +290,9 @@ node:
   # In certain scenarios, users might need to change the default dnsPolicy.
   dnsPolicy: ClusterFirstWithHostNet
 
+  registrar:
+    image: registry.k8s.io/sig-storage/csi-node-driver-registrar:v2.12.0
+
   healthMonitor:
     # enabled: Enable/Disable health monitor of CSI volumes- volume usage, volume condition
     # Allowed values:
@@ -378,9 +383,15 @@ autoProbe: true
 
 authorization:
   enabled: false
+
+  image: quay.io/dell/container-storage-modules/csm-authorization-sidecar:v1.12.0
+
   # proxyHost: hostname of the csm-authorization server
   # Default value: None
   proxyHost:
+  # rootCertificate: certificate used to communicate with the csm-authorization server
+  # Default value: None
+  rootCertificate:
   # skipCertificateValidation: certificate validation of the csm-authorization server
   # Allowed Values:
   #   "true" - TLS certificate verification will be skipped
@@ -405,6 +416,7 @@ storageCapacity:
 # Enable this feature only after contact support for additional information
 podmon:
   enabled: false
+  image: quay.io/dell/container-storage-modules/podmon:v1.11.0
   controller:
     args:
       - "--csisock=unix:/var/run/csi/csi.sock"
@@ -428,3 +440,11 @@ podmon:
       - "--driver-config-params=/csi-isilon-config-params/driver-config-params.yaml"
       - "--driverPodLabelValue=dell-storage"
       - "--ignoreVolumelessPods=false"
+
+secret:
+
+storageClasses:
+
+snapshotClasses:
+
+proxyAuthzTokens:
-- 
2.34.1
