From dca05af69c20f6b6fda4f99a6a3ecdaf9f564920 Mon Sep 17 00:00:00 2001
From: Guilherme Costa <guilherme.costa@windriver.com>
Date: Tue, 16 Apr 2024 15:44:08 -0300
Subject: [PATCH] csi-powerscale: add proxy secret in templates

Add template for proxy-server-root-certificate secret needed by the
csm-authorization sidecar.

Signed-off-by: Guilherme Costa <guilherme.costa@windriver.com>
---
 charts/csi-isilon/templates/controller.yaml          | 2 +-
 charts/csi-isilon/templates/node.yaml                | 2 +-
 charts/csi-isilon/templates/proxy-server-secret.yaml | 9 +++++++++
 charts/csi-isilon/values.yaml                        | 3 +++
 4 files changed, 14 insertions(+), 2 deletions(-)
 create mode 100644 charts/csi-isilon/templates/proxy-server-secret.yaml

diff --git a/charts/csi-isilon/templates/controller.yaml b/charts/csi-isilon/templates/controller.yaml
index 172ff8a..539fbd6 100644
--- a/charts/csi-isilon/templates/controller.yaml
+++ b/charts/csi-isilon/templates/controller.yaml
@@ -576,6 +576,6 @@ spec:
             secretName: karavi-authorization-config
         - name: proxy-server-root-certificate
           secret:
-            secretName: proxy-server-root-certificate
+            secretName: {{ .Release.Name }}-proxy-server-root-certificate
         {{ end }}
         {{ end }}
diff --git a/charts/csi-isilon/templates/node.yaml b/charts/csi-isilon/templates/node.yaml
index d81d535..8e675ca 100644
--- a/charts/csi-isilon/templates/node.yaml
+++ b/charts/csi-isilon/templates/node.yaml
@@ -414,7 +414,7 @@ spec:
             secretName: karavi-authorization-config
         - name: proxy-server-root-certificate
           secret:
-            secretName: proxy-server-root-certificate
+            secretName: {{ .Release.Name }}-proxy-server-root-certificate
         {{ end }}
         {{ end }}
         {{- if hasKey .Values "podmon" }}
diff --git a/charts/csi-isilon/templates/proxy-server-secret.yaml b/charts/csi-isilon/templates/proxy-server-secret.yaml
new file mode 100644
index 0000000..13de2d7
--- /dev/null
+++ b/charts/csi-isilon/templates/proxy-server-secret.yaml
@@ -0,0 +1,9 @@
+{{- if .Values.authorization.enabled  }}
+apiVersion: v1
+kind: Secret
+metadata:
+  name:  {{ .Release.Name }}-proxy-server-root-certificate
+  namespace: {{ .Release.Namespace }}
+stringData:
+    rootCertificate.pem: {{ .Values.authorization.rootCertificate | default "" | quote }}
+{{- end }}
diff --git a/charts/csi-isilon/values.yaml b/charts/csi-isilon/values.yaml
index 35183e4..49050e9 100644
--- a/charts/csi-isilon/values.yaml
+++ b/charts/csi-isilon/values.yaml
@@ -405,6 +405,9 @@ authorization:
   # proxyHost: hostname of the csm-authorization server
   # Default value: None
   proxyHost:
+  # rootCertificate: certificate used to communicate with the csm-authorization server
+  # Default value: None
+  rootCertificate:
   # skipCertificateValidation: certificate validation of the csm-authorization server
   # Allowed Values:
   #   "true" - TLS certificate verification will be skipped
-- 
2.34.1

