From 5c196fcd4c8e1e27a39501e3df37061182b7ef7b Mon Sep 17 00:00:00 2001
From: Alyson Deives Pereira <alyson.deivespereira@windriver.com>
Date: Wed, 22 Apr 2026 08:23:47 -0300
Subject: [PATCH] csireverseproxy: add default values for templates

This patch consists of adding the default values in the values.yaml of
the helm chart.
It's necessary because templates need default values to be able
to build the package.

Signed-off-by: Alyson Deives Pereira <alyson.deivespereira@windriver.com>
---
 charts/csi-powermax/charts/csireverseproxy/values.yaml | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/charts/csi-powermax/charts/csireverseproxy/values.yaml b/charts/csi-powermax/charts/csireverseproxy/values.yaml
index c8f57b5..778f834 100644
--- a/charts/csi-powermax/charts/csireverseproxy/values.yaml
+++ b/charts/csi-powermax/charts/csireverseproxy/values.yaml
@@ -5,3 +5,11 @@ port: 2222
 # Don't change this value unless really necessary
 # If this value is modified, then the installation script will have to be modified
 tlsSecret: "csirevproxy-tls-secret"
+
+certManager:
+  selfSignedCert:
+
+global:
+  logLevel:
+  storageArrays: []
+  managementServers: []
-- 
2.34.1
