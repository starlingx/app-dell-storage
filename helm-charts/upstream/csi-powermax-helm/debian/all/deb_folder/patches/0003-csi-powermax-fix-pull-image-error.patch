From a7e4d1128801ed5aed0eba7f682b8d31dc26b916 Mon Sep 17 00:00:00 2001
From: Alyson Deives Pereira <alyson.deivespereira@windriver.com>
Date: Wed, 22 Apr 2026 08:13:10 -0300
Subject: [PATCH] csi-powermax: fix pull image error

This patch consists of adding imagePullSecrets with name
default-registry-key only in ServiceAccounts.
It's necessary because without it the system can't use the
images from the registry local

Signed-off-by: Alyson Deives Pereira <alyson.deivespereira@windriver.com>
---
 charts/csi-powermax/templates/controller.yaml | 2 ++
 charts/csi-powermax/templates/node.yaml       | 2 ++
 2 files changed, 4 insertions(+)

diff --git a/charts/csi-powermax/templates/controller.yaml b/charts/csi-powermax/templates/controller.yaml
index 70c1e1d..fc446c8 100644
--- a/charts/csi-powermax/templates/controller.yaml
+++ b/charts/csi-powermax/templates/controller.yaml
@@ -14,6 +14,8 @@ metadata:
   {{- else }}
   name: {{ .Release.Name }}-controller
   {{- end }}
+imagePullSecrets:
+  - name: default-registry-key
 rules:
   - apiGroups: [""]
     resources: ["events"]
diff --git a/charts/csi-powermax/templates/node.yaml b/charts/csi-powermax/templates/node.yaml
index 9c68d74..51fdbc0 100644
--- a/charts/csi-powermax/templates/node.yaml
+++ b/charts/csi-powermax/templates/node.yaml
@@ -14,6 +14,8 @@ metadata:
   {{- else }}
   name: {{ .Release.Name }}-node
   {{- end }}
+imagePullSecrets:
+  - name: default-registry-key
 rules:
   - apiGroups: [""]
     resources: ["nodes"]
--
2.34.1
