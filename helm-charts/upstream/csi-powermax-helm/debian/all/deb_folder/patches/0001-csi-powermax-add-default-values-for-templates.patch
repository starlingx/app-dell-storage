From 7559b95b60d7f45db59944a66e162fcdc18cbcb0 Mon Sep 17 00:00:00 2001
From: Alyson Deives Pereira <alyson.deivespereira@windriver.com>
Date: Wed, 22 Apr 2026 08:08:12 -0300
Subject: [PATCH] csi-powermax: add default values for templates

This patch consists of adding the default values in the values.yaml of
the helm chart.
It's necessary because the images in templates were in unexpected format
for the system and because templates need default values to be able
to build the package.

Signed-off-by: Alyson Deives Pereira <alyson.deivespereira@windriver.com>
---
 charts/csi-powermax/values.yaml | 91 +++++++++++++++++++++------------
 1 file changed, 58 insertions(+), 33 deletions(-)

diff --git a/charts/csi-powermax/values.yaml b/charts/csi-powermax/values.yaml
index a45c5b2..52be649 100644
--- a/charts/csi-powermax/values.yaml
+++ b/charts/csi-powermax/values.yaml
@@ -92,44 +92,17 @@ global:
 # Don't modify this value as this value will be used by the install script
 version: "v2.16.2"

-# "images" defines every container images used for the driver and its sidecars.
-#  To use your own images, or a private registry, change the values here.
-images:
-  # "driver" defines the container image, used for the driver container.
-  driver:
-    image: quay.io/dell/container-storage-modules/csi-powermax:v2.16.2
-  csireverseproxy:
-    image: quay.io/dell/container-storage-modules/csipowermax-reverseproxy:v2.15.2
-  # CSI sidecars
-  attacher:
-    image: registry.k8s.io/sig-storage/csi-attacher:v4.10.0
-  provisioner:
-    image: registry.k8s.io/sig-storage/csi-provisioner:v6.1.0
-  snapshotter:
-    image: registry.k8s.io/sig-storage/csi-snapshotter:v8.4.0
-  resizer:
-    image: registry.k8s.io/sig-storage/csi-resizer:v2.0.0
-  registrar:
-    image: registry.k8s.io/sig-storage/csi-node-driver-registrar:v2.15.0
-  healthmonitor:
-    image: registry.k8s.io/sig-storage/csi-external-health-monitor-controller:v0.16.0
-  # CSM sidecars
-  replication:
-    image: quay.io/dell/container-storage-modules/dell-csi-replicator:v1.14.0
-  authorization:
-    image: quay.io/dell/container-storage-modules/csm-authorization-sidecar:v2.4.0
-  migration:
-    image: quay.io/dell/container-storage-modules/dell-csi-migrator:v1.10.0
-  podmon:
-    image: quay.io/dell/container-storage-modules/podmon:v1.15.0
-  # Node rescan sidecar does a rescan on nodes for identifying new paths
-  noderescan:
-    image: quay.io/dell/container-storage-modules/dell-csi-node-rescanner:v1.9.0
 ## K8S/DRIVER ATTRIBUTES
 ########################
 # customDriverName: If enabled, sets the driver name to the
 # value provided to its value field with namespace prefixed to it.

+driver:
+  # image: Image used for driver container. This shouldn't be changed
+  # Allowed values: string
+  # Default value: quay.io/dell/container-storage-modules/csi-powermax:v2.15.0
+  image: quay.io/dell/container-storage-modules/csi-powermax:v2.16.2
+
 # e.g, namespace.csi-powermax
 # Default value: None
 # Examples: "namespace.dellemc-array", "namespace.powermaxarray"
@@ -202,6 +175,18 @@ controller:
   # Examples: "volumes", "vol"
   volumeNamePrefix: csivol

+  provisioner:
+    # image: Image used for csi-provisioner sidecar. This shouldn't be changed
+    # Allowed values: string
+    # Default value: registry.k8s.io/sig-storage/csi-provisioner:v6.1.0
+    image: registry.k8s.io/sig-storage/csi-provisioner:v6.1.0
+
+  attacher:
+    # image: Image used for csi-attacher sidecar. This shouldn't be changed
+    # Allowed values: string
+    # Default value: registry.k8s.io/sig-storage/csi-attacher:v4.10.0
+    image: registry.k8s.io/sig-storage/csi-attacher:v4.10.0
+
   snapshot:
     # enabled: Enable/Disable volume snapshot feature
     # Allowed values:
@@ -215,6 +200,11 @@ controller:
     # Examples: "snap", "snapshot"
     snapNamePrefix: csi-snap

+    # image: Image used for csi-snapshotter sidecar. This shouldn't be changed
+    # Allowed values: string
+    # Default value: registry.k8s.io/sig-storage/csi-snapshotter:v8.4.0
+    image: registry.k8s.io/sig-storage/csi-snapshotter:v8.4.0
+
   resizer:
     # enabled: Enable/Disable volume expansion feature
     # Allowed values:
@@ -223,6 +213,11 @@ controller:
     # Default value: None
     enabled: true

+    # image: Image used for csi-resizer sidecar. This shouldn't be changed
+    # Allowed values: string
+    # Default value: registry.k8s.io/sig-storage/csi-resizer:v2.0.0
+    image: registry.k8s.io/sig-storage/csi-resizer:v2.0.0
+
   # nodeSelector: Define node selection constraints for controller pods.
   # For the pod to be eligible to run on a node, the node must have each
   # of the indicated key-value pairs as labels.
@@ -266,8 +261,24 @@ controller:
     # Default value: 60s
     interval: 60s

+    # image: Image used for csi-external-health-monitor-controller sidecar. This shouldn't be changed
+    # Allowed values: string
+    # Default value: registry.k8s.io/sig-storage/csi-external-health-monitor-controller:v0.16.0
+    image: registry.k8s.io/sig-storage/csi-external-health-monitor-controller:v0.16.0
+
 # node: configure node specific parameters
 node:
+  registrar:
+    # image: Image used for csi-node-driver-registrar sidecar. This shouldn't be changed
+    # Allowed values: string
+    # Default value: registry.k8s.io/sig-storage/csi-node-driver-registrar:v2.15.0
+    image: registry.k8s.io/sig-storage/csi-node-driver-registrar:v2.15.0
+
+  noderescan:
+    # Node rescan sidecar does a rescan on nodes for identifying new paths
+    # Default value: quay.io/dell/container-storage-modules/dell-csi-node-rescanner:v1.9.0
+    image: quay.io/dell/container-storage-modules/dell-csi-node-rescanner:v1.9.0
+
   # nodeSelector: Define node selection constraints for node pods.
   # For the pod to be eligible to run on a node, the node must have each
   # of the indicated key-value pairs as labels.
@@ -340,6 +351,8 @@ enableCHAP: false

 # csireverseproxy: Refers to the subchart csireverseproxy
 csireverseproxy:
+
+  image: quay.io/dell/container-storage-modules/csipowermax-reverseproxy:v2.15.2
   # "tlsSecret" defines the TLS secret that is created with certificate
   # and its associated key
   # Default value: None
@@ -442,6 +455,11 @@ replication:
   # Examples: "replication.storage.dell.com", "rdf.storage.dell.com"
   replicationPrefix: "replication.storage.dell.com"

+  # image: Image used for dell-csi-replicator sidecar. This shouldn't be changed
+  # Allowed values: string
+  # Default value: quay.io/dell/container-storage-modules/dell-csi-replicator:v1.14.0
+  image: quay.io/dell/container-storage-modules/dell-csi-replicator:v1.14.0
+
 # CSM module attributes
 # Set this to true to enable migration
 # Allowed values:
@@ -454,6 +472,7 @@ migration:
   # Default value: "migration.storage.dell.com"
   # Examples: "migration.storage.dell.com"
   migrationPrefix: "migration.storage.dell.com"
+  image: quay.io/dell/container-storage-modules/dell-csi-migrator:v1.10.0

 # CSM module attributes
 # authorization: enable csm-authorization for RBAC
@@ -474,6 +493,11 @@ authorization:
   # Default value: "true"
   skipCertificateValidation: true

+  # image: Image used for csm-authorization sidecar. This shouldn't be changed
+  # Allowed values: string
+  # Default value: quay.io/dell/container-storage-modules/csm-authorization-sidecar:v2.4.0
+  image: quay.io/dell/container-storage-modules/csm-authorization-sidecar:v2.4.0
+
 # Storage Capacity Tracking
 # Note: Capacity tracking is supported in kubernetes v1.24 and above, this feature will be automatically disabled in older versions.
 storageCapacity:
@@ -511,6 +535,7 @@ vSphere:

 # Enable this feature only after contact support for additional information
 podmon:
+  image: quay.io/dell/container-storage-modules/podmon:v1.15.0
   # podmonAPIPort: Defines the port to be used within the kubernetes cluster
   # Allowed values:
   # Any valid and free port.
--
2.34.1
