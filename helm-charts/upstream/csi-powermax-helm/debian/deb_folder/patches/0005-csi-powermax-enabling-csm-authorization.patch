                   key: refresh
           volumeMounts:
             - name: karavi-authorization-config
@@ -492,13 +492,13 @@ spec:
       {{- end }}
       {{- end }}
       {{- if hasKey .Values "authorization" }}
-      {{- if eq .Values.authorization.enabled true }}
+      {{- if or .Values.authorization.enabled .Values.csm.authorization }}
         - name: karavi-authorization-config
