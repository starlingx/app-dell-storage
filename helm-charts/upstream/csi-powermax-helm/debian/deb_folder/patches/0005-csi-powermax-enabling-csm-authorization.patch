   image: docker.io/dellemc/csi-powermax:v2.12.0
 
+  configs:
+
+  # rootCertificate: certificate used to communicate with the csm-authorization server
+  # Default value: None
+  rootCertificate:
+
 # e.g, namespace.csi-powermax
 # Default value: None
 # Examples: "namespace.dellemc-array", "namespace.powermaxarray"
@@ -513,6 +520,10 @@ vSphere:
   # vCenterCredSecret: secret name for the vCenter credentials
   vCenterCredSecret: vcenter-creds
 
+proxyAuthzTokens:
+  access:
+  refresh:
+
 # Enable this feature only after contact support for additional information
 podmon:
 
