From 7d8018702a5766f47063b45afab19be6f141361b Mon Sep 17 00:00:00 2001
From: Lorran Lucas Da Costa <lorran.dacosta@windriver.com>
Date: Thu, 26 Dec 2024 14:10:40 -0300
Subject: [PATCH] csi-powermax: enabling csm-authorization

This patch consists of:
  - change the format of the values in templates and changing the
    values.yaml for the user be able to enable csm-authorization.
  - Change some authorization secrets to use the release name as prefix.
    It'is necessary because we can activate more than one CSIs that use
    the same secret, so to avoid creating a conflict we add a prefix.
  - Adds authorization-config template to create the secret used by
    the csm-observability/csm-authorization
  - Add template for proxy-server-root-certificate secret needed by the
    csm-authorization sidecar.

Signed-off-by: Lorran Lucas Da Costa <lorran.dacosta@windriver.com>
---
 .../templates/authorization-config.yaml       | 20 +++++++++++++++++++
 charts/csi-powermax/templates/controller.yaml | 14 ++++++-------
 charts/csi-powermax/templates/node.yaml       | 14 ++++++-------
 .../templates/proxy-authz-tokens.yaml         | 10 ++++++++++
 .../templates/proxy-server-secret.yaml        |  9 +++++++++
 charts/csi-powermax/values.yaml               | 11 ++++++++++
 6 files changed, 64 insertions(+), 14 deletions(-)
 create mode 100644 charts/csi-powermax/templates/authorization-config.yaml
 create mode 100644 charts/csi-powermax/templates/proxy-authz-tokens.yaml
 create mode 100644 charts/csi-powermax/templates/proxy-server-secret.yaml

diff --git a/charts/csi-powermax/templates/authorization-config.yaml b/charts/csi-powermax/templates/authorization-config.yaml
new file mode 100644
index 0000000..2fc7b88
--- /dev/null
+++ b/charts/csi-powermax/templates/authorization-config.yaml
@@ -0,0 +1,20 @@
+{{- if or .Values.authorization.enabled .Values.csm.authorization }}
+{{- if .Values.authorization.configs }}
+apiVersion: v1
+kind: Secret
+metadata:
+  name: {{ .Release.Name }}-authorization-config
+  namespace: {{ .Release.Namespace }}
+stringData:
+  config: |
+    {{- range .Values.authorization.configs }}
+    - username: {{ .username }}
+      password: {{ .password }}
+      intendedEndpoint: {{ .intendedEndpoint }}
+      endpoint: {{ .endpoint | default "https://localhost:9400" }}
+      systemID: {{ .systemID }}
+      skipCertificateValidation: {{ .skipCertificateValidation | default true }}
+      isDefault: {{ .isDefault | default false }}
+    {{- end }}
+{{- end }}
+{{- end }}
diff --git a/charts/csi-powermax/templates/controller.yaml b/charts/csi-powermax/templates/controller.yaml
index 7cc1426..3ec96ff 100644
--- a/charts/csi-powermax/templates/controller.yaml
+++ b/charts/csi-powermax/templates/controller.yaml
@@ -145,7 +145,7 @@ metadata:
   name: {{ .Release.Name }}-controller
   namespace: {{ .Release.Namespace }}
   {{- if hasKey .Values "authorization" }}
-  {{- if eq .Values.authorization.enabled true }}
+  {{- if or .Values.authorization.enabled .Values.csm.authorization }}
   annotations:
       com.dell.karavi-authorization-proxy: "true"
   {{ end }}
@@ -345,7 +345,7 @@ spec:
         {{- end }}
         {{- end }}
         {{- if hasKey .Values "authorization" }}
-        {{- if eq .Values.authorization.enabled true }}
+        {{- if or .Values.authorization.enabled .Values.csm.authorization }}
         - name: karavi-authorization-proxy
           imagePullPolicy: {{ .Values.imagePullPolicy }}
           image: {{ required "Must provide the authorization sidecar container image." .Values.authorization.image }}
@@ -359,12 +359,12 @@ spec:
             - name: ACCESS_TOKEN
               valueFrom:
                 secretKeyRef:
-                  name: proxy-authz-tokens
+                  name: {{ .Release.Name }}-proxy-authz-tokens
                   key: access
             - name: REFRESH_TOKEN
               valueFrom:
                 secretKeyRef:
-                  name: proxy-authz-tokens
+                  name: {{ .Release.Name }}-proxy-authz-tokens
                   key: refresh
           volumeMounts:
             - name: karavi-authorization-config
@@ -555,12 +555,12 @@ spec:
           configMap:
             name: {{ .Release.Name }}-config-params
         {{- if hasKey .Values "authorization" }}
-        {{- if eq .Values.authorization.enabled true }}
+        {{- if or .Values.authorization.enabled .Values.csm.authorization }}
         - name: karavi-authorization-config
           secret:
-            secretName: karavi-authorization-config
+            secretName: {{ .Release.Name }}-authorization-config
         - name: proxy-server-root-certificate
           secret:
-            secretName: proxy-server-root-certificate
+            secretName: {{ .Release.Name }}-proxy-server-root-certificate
         {{ end }}
         {{ end }}
