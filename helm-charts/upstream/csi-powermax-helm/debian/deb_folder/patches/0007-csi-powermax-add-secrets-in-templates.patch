From f3b453b3d1b80ccb769341f139f752e18500ac79 Mon Sep 17 00:00:00 2001
From: Gabriel Przybysz Gonçalves Júnior <gabriel.przybsyzgoncalvesjunior@windriver.com>
Date: Wed, 12 Mar 2025 09:05:20 -0300
Subject: [PATCH] csi-powermax: add secrets in templates

This patch consists of adding a secrets in the helm chart templates
directory. It's needed because this helm chart needs a config secrets
that should be created manually.

Signed-off-by: Gabriel Przybysz Gonçalves Júnior <gabriel.przybsyzgoncalvesjunior@windriver.com>
---
 .../templates/default-secret.yaml             | 18 ++++++++++++++++
 charts/csi-powermax/templates/secrets.yaml    | 21 +++++++++++++++++++
 charts/csi-powermax/values.yaml               |  7 ++++++-
 3 files changed, 45 insertions(+), 1 deletion(-)
 create mode 100644 charts/csi-powermax/templates/default-secret.yaml
 create mode 100644 charts/csi-powermax/templates/secrets.yaml

diff --git a/charts/csi-powermax/templates/default-secret.yaml b/charts/csi-powermax/templates/default-secret.yaml
new file mode 100644
index 0000000..8f80677
--- /dev/null
+++ b/charts/csi-powermax/templates/default-secret.yaml
@@ -0,0 +1,18 @@
+{{- if .Values.global.defaultSecret }}
+apiVersion: v1
+kind: Secret
+metadata:
+{{- if .Values.global.defaultCredentialsSecret }}
+  name: {{ .Values.global.defaultCredentialsSecret }}
+{{- else }}
+  name: {{ .Release.Name }}-creds
+{{- end }}
+  namespace: {{ .Release.Namespace }}
+type: Opaque
+stringData:
+  username: {{ .Values.global.defaultSecret.username }}
+  password: {{ .Values.global.defaultSecret.password }}
+  {{- if and .Values.enableCHAP .Values.global.defaultSecret.chapsecret }}
+  chapsecret: {{ .Values.secret.chapsecret }}
+  {{- end }}
+{{- end }}
diff --git a/charts/csi-powermax/templates/secrets.yaml b/charts/csi-powermax/templates/secrets.yaml
new file mode 100644
index 0000000..65af38b
--- /dev/null
+++ b/charts/csi-powermax/templates/secrets.yaml
@@ -0,0 +1,21 @@
+{{- range $i, $ms := $.Values.global.managementServers }}
+{{- if $ms.credentialsSecret }}
+apiVersion: v1
+kind: Secret
+metadata:
+{{- if $ms.credentialsSecret }}
+  name: {{ $ms.credentialsSecret }}
+{{- else }}
+  name: {{ $.Release.Name }}-creds-{{ $i }}
+{{- end }}
+  namespace: {{ $.Release.Namespace }}
+type: Opaque
+stringData:
+  username: {{ $ms.username }}
+  password: {{ $ms.password }}
+  {{- if and $.Values.enableCHAP $ms.chapsecret }}
+  chapsecret: {{ $ms.chapsecret }}
+  {{- end }}
+---
+{{- end }}
+{{- end }}
diff --git a/charts/csi-powermax/values.yaml b/charts/csi-powermax/values.yaml
index 073941e..6ec57e9 100644
--- a/charts/csi-powermax/values.yaml
+++ b/charts/csi-powermax/values.yaml
@@ -20,7 +20,11 @@ global:
   # Examples: "000000000001", "000000000002"
   managedArrays: "000000000001,000000000002"
   # defaultCredentialsSecret
-  defaultCredentialsSecret: powermax-creds
+  defaultCredentialsSecret: csi-powermax-creds
+  defaultSecret:
+    username:
+    password:
+    chapsecret:
   # portGroups: Define the set of existing port groups that the driver will use.
   # It is a comma separated list of portgroup names.
   # Required only in case of iSCSI port groups
--
2.34.1
